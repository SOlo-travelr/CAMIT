# Sentinel Platform environment configuration
SENTINEL_ENV=development

# Database
DATABASE_URL=postgresql+psycopg://sentinel:sentinel@localhost:5432/sentinel
# For local dev without Postgres a SQLite fallback is used automatically.
SENTINEL_SQLITE_PATH=./data/sentinel.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Object storage (S3-compatible / MinIO)
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_ACCESS_KEY=minioadmin
OBJECT_STORE_SECRET_KEY=minioadmin
OBJECT_STORE_BUCKET=sentinel
# Local filesystem fallback for clips/snapshots when MinIO is unavailable
OBJECT_STORE_LOCAL_PATH=./data/object-store

# Optional LLM for policy translation (system runs fully without it)
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini

# Observability
PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO
